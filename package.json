  "repository": {
    "type": "git",
    "url": "https://github.com/magefayre/.github.git"
  },
  "homepage": "https://github.com/magefayre/github#readme",
  "bugs": {
    "url": "https://github.com/magefayre/github/issues"
  },
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "prepare": "husky",
    "test": "yarn lint",
    "lint": "concurrently 'yarn:lint:*'",
    "lint:js": "eslint --cache .",
    "lint:renovate": "renovate-config-validator renovate-config.json --strict",
    "format": "concurrently 'yarn:format:*'",
    "format:js": "yarn lint:js --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@newhighsco/commitlint-config": "1.3.5",
    "@newhighsco/editor-config": "1.2.0",
    "@newhighsco/eslint-config": "7.1.35",
    "@newhighsco/lint-staged-config": "1.1.4",
    "@newhighsco/prettier-config": "2.3.14",
    "@newhighsco/yarn-plugin-preset": "1.1.4",
    "concurrently": "10.0.4",
    "eslint": "10.8.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "renovate": "44.23.0"
  },
  "commitlint": {
    "extends": [
      "@newhighsco"
    ]
  },
  "prettier": "@newhighsco/prettier-config"
}
